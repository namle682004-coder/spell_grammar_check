# API server
API_PORT=8080
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Legacy global API key (optional; per-user X-API-Key is preferred)
API_KEY=your_secret_api_key_here

# Hugging Face credentials
HF_TOKEN=hf_your_token_here
HF_HOME=~/.cache/huggingface

# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=chapter06-finetune
WANDB_ENTITY=your_wandb_entity

# GPU selection (optional)
CUDA_VISIBLE_DEVICES=0

# Override output root (optional)
OUTPUT_ROOT=./outputs

# Finetuned model for API (optional; default: outputs/production/current)
# FINETUNE_MODEL=outputs/production/current

# vLLM inference server (optional; when set, API calls vLLM instead of loading model locally)
# VLLM_BASE_URL=http://localhost:8000

# Database (required for API SaaS layer)
DATABASE_URL=postgresql+psycopg://spellgrammar_user:spellgrammar_pass@localhost:5432/spell_grammar_db

# Usage storage
USAGE_STORAGE_ROOT=./storage

# Environment: set to production to enforce JWT_SECRET
ENV=development
